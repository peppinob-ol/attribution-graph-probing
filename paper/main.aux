\citation{templeton2024scaling}
\newlabel{tab:domains}{{2}{7}{\textbf {Five evaluation domains.} Each row gives the seed-prompt template, the three semantic fields (input / intermediate / answer), the answer-set size $K$, the number of entities and non-identity swap pairs, and the total run count across all conditions (labeled, matched-random $\times 3$, 7 field-additivity variants, adaptive-$M$ rescue). The four \emph {strong} domains (USA, Books, Products, Paintings) are used for cross-domain inference; \emph {Sounds} is reported separately as a directional negative (\cref {sec:results:negative}). Full per-condition counts in \cref {appx:specificity,appx:fieldadd,appx:msearch}.\relax }{table.caption.4}{}}
\newlabel{tab:domains@cref}{{[table][2][]2}{[1][6][]7}}
\newlabel{tab:headline}{{3}{7}{\textbf {Headline (C1): labeled supernodes vs.\ matched random controls.} For each domain we report (a) the per-pair best field-add variant with adaptive $M$-search Hit\% (a comprehensive operational measure), and (b) the labeled vs.\ matched-random vsMax discriminator at the full-labeled all-fields $M{=}20$ baseline (the cleanest specificity signal; full per-condition tables in \cref {appx:specificity}). Hit\% counts pairs whose first generated subword matches the target answer; vsMax is the best logit margin against the strongest competing dataset answer. C1 (\cref {def:opuseful}) is supported when both Hit-rate gap $\geq 5$~pp and vsMax gap $\geq 1.0$ logit. Sounds fails Condition~2 (vsMax gap $+0.14$) and is reported as a directional negative (\cref {sec:results:negative}).\relax }{table.caption.5}{}}
\newlabel{tab:headline@cref}{{[table][3][]3}{[1][6][]7}}
\newlabel{tab:fieldadd}{{4}{7}{\textbf {Less-is-more (C2.1): smaller field subsets beat the all-three-field intervention.} Per-domain best subset vs.\ the all-3-field labeled baseline at $M{=}20$. In 4/5 domains the intermediate field carries the strongest signal; pairing it with the answer field yields a 9--33~pp gain. Per-variant tables in \cref {appx:fieldadd}.\relax }{table.caption.7}{}}
\newlabel{tab:fieldadd@cref}{{[table][4][]4}{[1][6][]7}}
\newlabel{sec:results:c2:layers}{{6.2.3}{7}{}{subsubsection.6.2.3}{}}
\newlabel{sec:results:c2:layers@cref}{{[subsubsection][3][6,2]6.2.3}{[1][7][]7}}
\newlabel{sec:results:c2:scaffold}{{6.2.4}{7}{}{subsubsection.6.2.4}{}}
\newlabel{sec:results:c2:scaffold@cref}{{[subsubsection][4][6,2]6.2.4}{[1][7][]7}}
\newlabel{fig:regime}{{3}{8}{\textbf {C1 evidence: regime decomposition and within-regime~C signals.} (a) Stacked-bar regime distributions (A/C/D/E) for the per-pair best variant, the full labeled (M=20), and matched random across the 4 strong domains. The best variant concentrates in regime A; random concentrates in regime D. (b) Within regime~C in USA, labeled vs.\ random on three sub-regime signals: Target-Recovery rate (92.2 vs 29.3\%), sustained dominance (\texttt {tgt\_win\_pct} 0.673 vs 0.319), and vsMax ($+2.33$ vs $-0.10$). Numbers in \cref {appx:regime}.\relax }{figure.caption.6}{}}
\newlabel{fig:regime@cref}{{[figure][3][]3}{[1][6][]8}}
\newlabel{fig:mhist}{{4}{8}{\textbf {Bimodal winning-$M$ distribution.} Histogram of $M_{\mathrm {amplify}}$ values rescuing missed pairs in adaptive search ($N{=}452$), with KL$(\mathrm {baseline} \| \mathrm {steered})$ overlay. The canonical $M{=}20$ default (dashed line) is to the right of both peaks ($\sim 2.4$ and $\sim 6.9$). High-$M$ rescue and top-$k$ rescue are both null (\cref {appx:msearch}).\relax }{figure.caption.8}{}}
\newlabel{fig:mhist@cref}{{[figure][4][]4}{[1][7][]8}}
