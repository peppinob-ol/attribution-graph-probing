{
  "version": 0.1,
  "display_demo": true,
  "inputs": {
    "source_config": "configs/paintings_painters_full.yml",
    "graphs_root": "<repo>/output/paintings_painters_batch"
  },
  "swap": {
    "mode": "matrix",
    "include_identity": true,
    "concept_fields": [
      "painting",
      "painter",
      "first_name"
    ],
    "answer_field": "first_name"
  },
  "ct_steering": {
    "model_id": "google/gemma-2-2b",
    "transcoder_set": "mntss/clt-gemma-2-2b-2.5M",
    "M_ablate": -2,
    "M_amplify": 20,
    "temperature": 0.3,
    "n_tokens": 10,
    "freq_penalty": 2.0,
    "seed": 42,
    "top_k": 5,
    "freeze_attention": false,
    "track_trajectory": true
  },
  "compute": {
    "inherit_from_source": false,
    "remote": {
      "enabled": false
    }
  },
  "steps": {
    "validate_inputs": true,
    "prepare_features": true,
    "run_steering": true,
    "aggregate_results": true
  },
  "experiment_name": "fullscale_paintings_random",
  "control": {
    "mode": "random_feature_matched",
    "replicates": 3,
    "seed": 42,
    "matching": {
      "match_layers": true
    },
    "exclusions": {
      "exclude_labeled_features": true,
      "exclude_concept_matching_supernodes": true
    }
  },
  "_entities": [
    {
      "slug": "water_lilies",
      "painting": "Water Lilies",
      "painter": "Claude Monet",
      "first_name": "Claude"
    },
    {
      "slug": "starry_night",
      "painting": "The Starry Night",
      "painter": "Vincent van Gogh",
      "first_name": "Vincent"
    },
    {
      "slug": "persistence_of_memory",
      "painting": "The Persistence of Memory",
      "painter": "Salvador Dali",
      "first_name": "Salvador"
    },
    {
      "slug": "campbells_soup",
      "painting": "Campbell's Soup Cans",
      "painter": "Andy Warhol",
      "first_name": "Andy"
    },
    {
      "slug": "guernica",
      "painting": "Guernica",
      "painter": "Pablo Picasso",
      "first_name": "Pablo"
    },
    {
      "slug": "american_gothic",
      "painting": "American Gothic",
      "painter": "Grant Wood",
      "first_name": "Grant"
    },
    {
      "slug": "girl_pearl_earring",
      "painting": "Girl with a Pearl Earring",
      "painter": "Johannes Vermeer",
      "first_name": "Johannes"
    },
    {
      "slug": "birth_of_venus",
      "painting": "The Birth of Venus",
      "painter": "Sandro Botticelli",
      "first_name": "Sandro"
